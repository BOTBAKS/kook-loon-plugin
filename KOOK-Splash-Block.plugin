#!name = KOOK 开屏广告拦截
#!desc = 拦截 KOOK 启动/开屏广告请求，并清理启动配置中的广告字段
#!author = Codex
#!homepage = https://github.com/BOTBAKS/kook-loon-plugin
#!icon = https://raw.githubusercontent.com/luestr/IconResource/main/App_icon/120px/KOOK.png
#!loon_version = 3.2.1(749)
#!date = 2026-11-08
#!tag = 去广告,KOOK

# 说明：仅匹配 KOOK 自有域名的启动/开屏/广告接口。
# 需要在 Loon 中开启 MitM，并信任 Loon CA 证书。

[Rule]
# 启动/开屏广告请求：按路径关键词精确拦截，避免拦截普通聊天和语音接口。
URL-REGEX,^https?:\/\/(?:www\.)?kookapp\.cn\/(?:api|app)\/(?:v\d+\/)?[^?#]*(?:splash|startup|launch|advert|adslot|ad_config|advertisement)[^?#]*(?:[?#].*)?$,REJECT
URL-REGEX,^https?:\/\/api\.kookapp\.cn\/(?:v\d+\/)?[^?#]*(?:splash|startup|launch|advert|adslot|ad_config|advertisement)[^?#]*(?:[?#].*)?$,REJECT

[Rewrite]
# 部分版本把广告作为启动配置 JSON 的字段下发；删除常见广告字段后返回原配置。
^https?:\/\/(?:www\.)?kookapp\.cn\/(?:api|app)\/.* response-body-json-jq 'del(.data.ad,.data.ads,.data.advert,.data.advertisement,.data.advertisements,.data.splash,.data.splash_ad,.data.startup_ad,.data.startup_ads,.data.banner_ad,.data.banner_ads,.data.popup,.data.popups,.data.promotion,.data.promotions)'
^https?:\/\/api\.kookapp\.cn\/.* response-body-json-jq 'del(.data.ad,.data.ads,.data.advert,.data.advertisement,.data.advertisements,.data.splash,.data.splash_ad,.data.startup_ad,.data.startup_ads,.data.banner_ad,.data.banner_ads,.data.popup,.data.popups,.data.promotion,.data.promotions)'

[MitM]
hostname = www.kookapp.cn, kookapp.cn, api.kookapp.cn




